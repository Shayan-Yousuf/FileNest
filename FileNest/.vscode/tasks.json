{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FileNest: Build",
      "type": "shell",
      "command": "javac",
      "args": [
        "--release",
        "17",
        "-Xlint:all",
        "-d",
        "out",
        "src/filenest/FileNestApp.java"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$javac",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "FileNest: Run GUI",
      "type": "shell",
      "command": "java",
      "args": [
        "-cp",
        "out",
        "filenest.FileNestApp"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "FileNest: Build",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "FileNest: Build JAR",
      "type": "shell",
      "command": "jar",
      "args": [
        "--create",
        "--file",
        "FileNest.jar",
        "--main-class",
        "filenest.FileNestApp",
        "-C",
        "out",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "FileNest: Build",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
